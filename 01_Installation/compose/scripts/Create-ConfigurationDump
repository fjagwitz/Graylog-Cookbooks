#!/bin/bash
#
# Usage: 
# Create-ConfigurationDump

sudo date >/dev/null

GRAYLOG_PATH="/opt/graylog"
BACKUP_FOLDER="backup"
BACKUP_STACK_FOLDER="$(date "+%Y-%m-%d_%H-%M-%S")_GRAYLOG_STACK_BACKUP"
BACKUP_MONGO_FOLDER="$(date "+%Y-%m-%d_%H-%M-%S")_GRAYLOG_CONFIGURATION_BACKUP"

sudo mkdir ${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_STACK_FOLDER}
sudo cp ${GRAYLOG_PATH}/*.yaml ${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_STACK_FOLDER}
sudo cp ${GRAYLOG_PATH}/*.env ${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_STACK_FOLDER}
sudo cp ${GRAYLOG_PATH}/*.txt ${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_STACK_FOLDER}

sudo tar -czf "${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_STACK_FOLDER}.tar.gz" "${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_STACK_FOLDER}" 2>/dev/null

sudo rm -rf "${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_STACK_FOLDER}"

sudo docker compose -f ${GRAYLOG_PATH}/docker-compose.yaml exec mongodb1 mongodump --host=localhost --port=27017 --out "/${BACKUP_FOLDER}/${BACKUP_MONGO_FOLDER}" --quiet
sudo tar -czf "${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_MONGO_FOLDER}.tar.gz" "${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_MONGO_FOLDER}" 2>/dev/null

sudo rm -rf "${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_MONGO_FOLDER}"

BACKUP_MONGO_FOLDER_SIZE=$(du -h "${GRAYLOG_PATH}/${BACKUP_FOLDER}/${BACKUP_MONGO_FOLDER}.tar.gz" | cut -f1)

if [[ ${USER} == "" ]]
then
  USER="GRAYLOG SYSTEM"
fi

echo "[INFO] - GRAYLOG CONFIGURATION BACKUP (SIZE: ${BACKUP_MONGO_FOLDER_SIZE}) SUCCESSFULLY CREATED BY ${USER^^}" 
echo "[INFO] - GRAYLOG CONFIGURATION BACKUP (SIZE: ${BACKUP_MONGO_FOLDER_SIZE}) SUCCESSFULLY CREATED BY ${USER^^}" | logger -p user.info -e -t GRAYLOG-HELPER

NUMBER_OF_BACKUPS=$(ls -l ${GRAYLOG_PATH}/${BACKUP_FOLDER}/ | grep -i dump | wc -l)

while [ ${NUMBER_OF_BACKUPS} -gt 14 ]
do
  
  FILE_TO_DELETE=$(ls ${GRAYLOG_PATH}/${BACKUP_FOLDER}/ | grep -i dump | sort | head -n1)
  sudo rm ${GRAYLOG_PATH}/${BACKUP_FOLDER}/${FILE_TO_DELETE}
  NUMBER_OF_BACKUPS=$((${NUMBER_OF_BACKUPS}-1))
  
  echo "[INFO] - GRAYLOG CONFIGURATION BACKUP ${FILE_TO_DELETE} DELETED BY ${USER^^}, ${NUMBER_OF_BACKUPS} BACKUPS REMAINING"
  echo "[INFO] - GRAYLOG CONFIGURATION BACKUP ${FILE_TO_DELETE} DELETED BY ${USER^^}, ${NUMBER_OF_BACKUPS} BACKUPS REMAINING" | logger -p user.info -e -t GRAYLOG-HELPER

done
