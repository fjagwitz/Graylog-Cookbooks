      "id": "33c80617-cb51-4ba0-9fa2-6e5225060ac6",
      "data": {
        "title": {
          "@type": "string",
          "@value": "10 - Windows Server Information - Server Roles"
        },
        "description": null,
        "source": {
          "@type": "string",
          "@value": "rule \"10 - Windows Server Information - Server Roles\"\nwhen\n    to_string($message.nxlog_tag) == \"Compliance_WindowsServerRoles\"\n    \nthen\n    let mylog = to_map(parse_json(to_string($message.full_message)));\n    \n    set_fields(mylog);\n    \n    remove_multiple_fields(\n        names: [\n            \"AdditionalInfo\"\n            \"collector_node_id\"\n            \"DependsOn\"\n            \"Depth\"\n            \"EventReceivedTime\"\n            \"Description\"\n            \"InstallState\"\n            \"level\"\n            \"Notification\"\n            \"Path\"\n            \"ServerComponentDescriptor\"\n            \"SubFeatures\"\n            \"SystemService\"\n            \"full_message\"\n        ]\n    );\n    \n    rename_fields(\n        fields: {\n            DisplayName:            \"windows_feature_displayname\"\n            FeatureType:            \"windows_feature_featuretype\"\n            Installed:              \"windows_feature_installstate\"\n            Name:                   \"windows_feature_name\"\n            PostConfigurationNeeded: \"windows_feature_postconfiguration\"\n            SourceModuleName:       \"windows_feature_sourcemodule\"\n            SourceModuleType:       \"agent_module_type\"\n        }\n    );\n\nend"
        }
      },
      "constraints": [
        {
          "type": "server-version",
          "version": ">=7.2.2+94adc86"
        }
      ]
    },
